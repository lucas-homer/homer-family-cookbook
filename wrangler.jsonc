{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homer-family-cookbook",
  "account_id": "d7e6f52c128468fc605d09012d9ac8da",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  // Serves the site at the apex domain. Cloudflare manages the DNS record and
  // certificate. It was first attached with the owner's wrangler login; the
  // scoped agent token can redeploy with it in place.
  "routes": [{ "pattern": "homerfamilycookbook.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homer-family-cookbook",
      "database_id": "a32854f1-55ff-4433-a511-71dceddae819",
      "migrations_dir": "migrations"
    }
  ],
  // Throttles login attempts before any bcrypt work, keyed per IP and per email.
  // Limits are approximate and per Cloudflare location.
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Cloudflare Email Service, for password reset emails (src/server/email.ts).
  // homerfamilycookbook.com must be onboarded under Compute & AI > Email
  // Service, and sending needs the Workers Paid plan.
  "send_email": [{ "name": "EMAIL" }],
  // Recipe photos and videos (src/server/media.ts). Private bucket: files are
  // served through GET /api/v1/media/:id, never a public bucket URL.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "homer-family-cookbook-media" }],
  // Secrets (set with `wrangler secret put`, never committed): none yet.
}
