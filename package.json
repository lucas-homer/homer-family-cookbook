{
  "name": "homer-family-cookbook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "CLOUDFLARE_API_TOKEN=$HFC_CLOUDFLARE_API_TOKEN wrangler d1 migrations apply DB --remote",
    "deploy": "vite build && CLOUDFLARE_API_TOKEN=$HFC_CLOUDFLARE_API_TOKEN wrangler deploy"
  },
  "dependencies": {
    "@effect/sql-d1": "^4.0.7",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "bcryptjs": "^3.0.3",
    "effect": "^4.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
