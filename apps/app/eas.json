{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "autoIncrement": true
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    },
    "development-local": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:5173"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6840185203"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6840185203"
      }
    }
  }
}
