{
  "expo": {
    "name": "Family Cookbook",
    "slug": "homer-family-cookbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "bundleIdentifier": "com.homerfamilycookbook.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C8381F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.homerfamilycookbook.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "familycookbook",
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos to add to your recipes.",
          "cameraPermission": "Take photos and videos for your recipes.",
          "microphonePermission": "Record sound with videos for your recipes."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "apiUrl": "https://homerfamilycookbook.com",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b9d9e533-0848-4462-817e-2f456c804dbf"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "lucas.homer"
  }
}
